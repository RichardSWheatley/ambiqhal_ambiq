/*
 * ARB diff-drive sample - Apollo510 EVB overlay
 *
 * Pin map:
 *   Motor L: PWM GPIO12 (CTIMER0 out0), DIR GPIO13
 *   Motor R: PWM GPIO18 (CTIMER1 out0), DIR GPIO19
 *   Encoder L: A GPIO24, B GPIO25   (3.3 V VDDP domain)
 *   Encoder R: A GPIO26, B GPIO27
 *   IMU (ICM-42688-P): SDA GPIO5, SCL GPIO6 (IOM0), addr 0x68
 *   ARB link: UART1 TX GPIO48, RX GPIO49, 921600 8N1
 *
 * SPDX-License-Identifier: Apache-2.0
 * Copyright (c) 2026 Ambiq Micro Inc. <www.ambiq.com>
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	chosen {
		arb,uart = &uart1;
	};

	zephyr,user {
		/* index 0 = left, 1 = right */
		pwms = <&pwm_ctimer0 0 PWM_HZ(20000) PWM_POLARITY_NORMAL>,
		       <&pwm_ctimer1 0 PWM_HZ(20000) PWM_POLARITY_NORMAL>;
		dir-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>,
			    <&gpio0 19 GPIO_ACTIVE_HIGH>;
		/* left A, left B, right A, right B */
		enc-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>,
			    <&gpio0 25 GPIO_ACTIVE_HIGH>,
			    <&gpio0 26 GPIO_ACTIVE_HIGH>,
			    <&gpio0 27 GPIO_ACTIVE_HIGH>;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&uart1 {
	status = "okay";
	current-speed = <921600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

&pwm_ctimer0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-names = "default";
};

&pwm_ctimer1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-names = "default";
};

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <AMBIQ_PIN(5, IOM0_SDA)>,
				 <AMBIQ_PIN(6, IOM0_SCL)>;
			drive-open-drain;
			bias-pull-up;
		};
	};

	uart1_default: uart1_default {
		group1 {
			pinmux = <AMBIQ_PIN(48, UART1_TX)>;
		};
		group2 {
			pinmux = <AMBIQ_PIN(49, UART1_RX)>;
			input-enable;
		};
	};

	pwm0_default: pwm0_default {
		group1 {
			pinmux = <AMBIQ_PIN(12, CT0_OUT0)>;
		};
	};

	pwm1_default: pwm1_default {
		group1 {
			pinmux = <AMBIQ_PIN(18, CT1_OUT0)>;
		};
	};
};
