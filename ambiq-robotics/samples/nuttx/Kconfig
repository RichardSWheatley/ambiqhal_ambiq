config ARB_DIFFDRIVE
	tristate "ARB differential-drive sample"
	default n
	---help---
		Ambiq Robotics Broker closed-loop differential-drive node
		(diff_drive + PID) running on the NuttX broker port.

if ARB_DIFFDRIVE

config ARB_DIFFDRIVE_PROGNAME
	string "Program name"
	default "arb_diffdrive"

config ARB_DIFFDRIVE_PRIORITY
	int "Task priority"
	default 100

config ARB_DIFFDRIVE_STACKSIZE
	int "Stack size"
	default 4096

endif
