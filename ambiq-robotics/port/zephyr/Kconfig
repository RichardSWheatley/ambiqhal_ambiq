menuconfig ARB
	bool "Ambiq Robotics Broker (ARB) middleware"
	help
	  OS-agnostic robotics pub/sub + service broker with a HAL abstraction
	  for motors, encoders and IMUs, ported onto Zephyr primitives.

if ARB

config ARB_QUEUE_DEPTH
	int "Dispatch queue depth"
	default 16
	help
	  Number of messages buffered between arb_topic_publish() and delivery.

config ARB_MAX_TOPICS
	int "Maximum advertised topics"
	default 16

config ARB_MAX_SUBSCRIBERS
	int "Maximum subscribers (total, across all topics)"
	default 32

config ARB_MAX_SERVICES
	int "Maximum registered services"
	default 16

config ARB_DISPATCH_THREAD
	bool "Run a dedicated dispatcher thread"
	default y
	help
	  When enabled, a kernel thread blocks on the message queue and delivers
	  messages to subscribers automatically. When disabled, the application
	  must call arb_platform_dispatch() itself.

if ARB_DISPATCH_THREAD

config ARB_DISPATCH_THREAD_STACK_SIZE
	int "Dispatcher thread stack size"
	default 2048

config ARB_DISPATCH_THREAD_PRIORITY
	int "Dispatcher thread priority"
	default 5

endif # ARB_DISPATCH_THREAD

config ARB_MICRO_ROS_BRIDGE
	bool "micro-ROS bridge"
	default n
	help
	  Build the micro-ROS adapter that mirrors internal ARB topics to ROS2
	  publishers/subscribers. Requires the micro-ROS Zephyr module.

config ARB_JAUS_BRIDGE
	bool "JAUS bridge (UDP)"
	default n
	select NETWORKING
	select NET_UDP
	select NET_SOCKETS
	help
	  Build the JAUS (SAE AS-4) bridge with a Zephyr UDP transport, exposing
	  the node on a JAUS network (SetWrenchEffort -> /cmd_vel; /odom ->
	  ReportVelocityState/ReportLocalPose).

endif # ARB
