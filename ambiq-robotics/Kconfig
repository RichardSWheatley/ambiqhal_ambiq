menuconfig ARB
	bool "Ambiq Robotics Broker (ARB)"
	select ZBUS
	help
	  Robotics building blocks on top of zbus: a shared message vocabulary
	  (arb/msg.h), well-known channels (arb/topics.h), JAUS/ROS2-style node
	  lifecycle with emergency stop (arb/node.h), and control helpers
	  (PID, differential-drive kinematics). Messaging is plain zbus.

if ARB

module = ARB
module-str = arb
source "subsys/logging/Kconfig.template.log_config"

config ARB_MAX_NODES
	int "Maximum number of lifecycle nodes"
	default 8

config ARB_HEARTBEAT_TICK_MS
	int "Heartbeat scheduler resolution (ms)"
	default 100
	help
	  Node heartbeats are published from a delayable work item that runs at
	  this period; individual node periods round up to it.

choice ARB_TIME_SOURCE
	prompt "Time base for message stamps"
	default ARB_TIME_UPTIME
	help
	  Source behind arb_time_now_us(), used for every message stamp.

config ARB_TIME_UPTIME
	bool "Local kernel uptime"
	help
	  Monotonic local time; meaningless across the link.

config ARB_TIME_PTP
	bool "PTP clock device"
	depends on PTP_CLOCK
	help
	  Read the ptp_clock device named by the devicetree chosen node
	  "arb,ptp-clock" - the backend for boards disciplined by gPTP.
	  Falls back to local uptime while the device is not ready.

endchoice

config ARB_TRANSPORT
	bool "Channel transport (bridge exported channels to a peer)"
	select ZBUS_RUNTIME_OBSERVERS
	help
	  Frame exported zbus channels toward a peer and publish received
	  frames onto the matching channels. Wire format:
	  0x7E | topic(2) | len(2) | payload | crc16, independent of the
	  backend carrying the bytes.

if ARB_TRANSPORT

choice ARB_TRANSPORT_BACKEND
	prompt "Transport backend"
	default ARB_TRANSPORT_SERIAL

config ARB_TRANSPORT_SERIAL
	bool "Serial (UART)"
	depends on SERIAL
	depends on UART_INTERRUPT_DRIVEN
	help
	  Bridge over the UART named by the devicetree chosen node
	  "arb,uart".

config ARB_TRANSPORT_UDP
	bool "UDP socket"
	depends on NET_SOCKETS
	help
	  Bridge over a UDP socket (whole frames inside datagrams). On
	  native_sim, combine with NSOS offloaded sockets
	  (CONFIG_NET_NATIVE_OFFLOADED_SOCKETS) for zero host setup.

endchoice

config ARB_TRANSPORT_UDP_LOCAL_PORT
	int "UDP local port"
	depends on ARB_TRANSPORT_UDP
	default 17447

config ARB_TRANSPORT_UDP_PEER_ADDR
	string "UDP peer IPv4 address"
	depends on ARB_TRANSPORT_UDP
	default "127.0.0.1"

config ARB_TRANSPORT_UDP_PEER_PORT
	int "UDP peer port"
	depends on ARB_TRANSPORT_UDP
	default 17447

endif # ARB_TRANSPORT

endif # ARB
