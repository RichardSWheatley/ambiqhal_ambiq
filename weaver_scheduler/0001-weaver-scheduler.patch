+sample:
+  description: Canonical Weaver benchmark workload (RFC §7.1) for Apollo510B
+    LP at 96 MHz. Builds with one of stock / scalar / hybrid / full-MVE batch
+    variants (extra_args).
+  name: Weaver Benchmark
+common:
+  tags:
+    - kernel
+    - weaver
+    - benchmark
+  harness: console
+  harness_config:
+    type: one_line
+    regex:
+      - "BENCHMARK COMPLETE"
+tests:
+  sample.kernel.weaver_benchmark.scalar:
+    platform_allow: apollo510b_evb
