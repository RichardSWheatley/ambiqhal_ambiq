+  sample.kernel.weaver_benchmark.hybrid:
+    platform_allow: apollo510b_evb
+    integration_platforms: [apollo510b_evb]
+    extra_args: EXTRA_CONF_FILE=hybrid.conf
+  sample.kernel.weaver_benchmark.mve:
+    platform_allow: apollo510b_evb
+    integration_platforms: [apollo510b_evb]
+    extra_args: EXTRA_CONF_FILE=mve.conf
+  sample.kernel.weaver_benchmark.stock:
+    platform_allow: apollo510b_evb
+    integration_platforms: [apollo510b_evb]
+    extra_args: EXTRA_CONF_FILE=stock.conf
+  sample.kernel.weaver_benchmark.fp:
+    platform_allow: apollo510b_evb
+    integration_platforms: [apollo510b_evb]
