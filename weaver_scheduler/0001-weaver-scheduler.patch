+# Weaver wearable on Apollo510 Blue EVB at 96 MHz LP mode.
+# Real sensors via mikroBUS Click boards: BMI270 (IMU) + MAX30101 (PPG).
+# BLE on iom6/spi6 (built into board DTS).
+# Display via ap510_disp shield (built-in option).
+
+# --- Weaver scheduler ---
+CONFIG_WEAVER_SCHED=y
+CONFIG_WEAVER_WEARABLE_PRESET=y
+
+# --- Sensor API ---
+CONFIG_I2C=y
+CONFIG_SENSOR=y
+CONFIG_BMI270=y
+CONFIG_MAX30101=y
+
+# --- BLE host stack (optional, demo registers GATT TX as a Weft) ---
+CONFIG_BT=y
+CONFIG_BT_PERIPHERAL=y
+CONFIG_BT_DEVICE_NAME="Weaver Wearable"
+CONFIG_BT_DIS=y
+
+# --- Console / logging ---
+CONFIG_LOG=y
+CONFIG_LOG_MODE_MINIMAL=y
+CONFIG_THREAD_NAME=y
+CONFIG_THREAD_RUNTIME_STATS=y
+
+CONFIG_MAIN_STACK_SIZE=4096
+CONFIG_HEAP_MEM_POOL_SIZE=4096
+
+# --- 1 ms tick for fine-grained pre-warp guard timing ---
+CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
+
+# --- Single core M55 ---
+CONFIG_MP_MAX_NUM_CPUS=1
+
+# --- Power management for wearable battery life ---
+CONFIG_PM=y
+CONFIG_PM_DEVICE=y
+CONFIG_PM_DEVICE_RUNTIME=y
+
+# --- On-target dispatch-cycle measurement (DWT cycle counter) ---
+CONFIG_WEAVER_TIMING=y
