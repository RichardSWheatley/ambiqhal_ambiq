+# Weaver canonical benchmark workload (RFC §7.1).
+#
+# Build three times to compare the pressure-batch variants. Use
+# scripts/bench.sh in this sample directory to automate.
+#
+# Default here is SCALAR. Override via:
+#   west build ... -- -DEXTRA_CONF_FILE=hybrid.conf
+#   west build ... -- -DEXTRA_CONF_FILE=mve.conf
+#   west build ... -- -DEXTRA_CONF_FILE=stock.conf
+
+CONFIG_WEAVER_SCHED=y
+CONFIG_WEAVER_WEARABLE_PRESET=y
+CONFIG_WEAVER_BATCH_SCALAR=y
+CONFIG_WEAVER_TIMING=y
+
+CONFIG_LOG=y
+CONFIG_LOG_MODE_MINIMAL=y
+CONFIG_THREAD_NAME=y
+CONFIG_THREAD_RUNTIME_STATS=y
+
+CONFIG_MAIN_STACK_SIZE=4096
+CONFIG_HEAP_MEM_POOL_SIZE=4096
+CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
+CONFIG_MP_MAX_NUM_CPUS=1
+
+CONFIG_PM=y
+CONFIG_PM_DEVICE=y
+CONFIG_PM_DEVICE_RUNTIME=y
