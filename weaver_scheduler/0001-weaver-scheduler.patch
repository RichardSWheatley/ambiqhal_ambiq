@@ -0,0 +1,22 @@
+# Weaver wearable sample tuned for Apollo510 LP @ 96 MHz.
+
+CONFIG_WEAVER_SCHED=y
+CONFIG_WEAVER_WEARABLE_PRESET=y
+
+CONFIG_LOG=y
+CONFIG_LOG_MODE_MINIMAL=y
+
+CONFIG_MAIN_STACK_SIZE=2048
+CONFIG_THREAD_NAME=y
+CONFIG_THREAD_RUNTIME_STATS=y
+
+# 1 ms system tick keeps Weaver granularity tight without dominating
+# CPU at 96 MHz (per-tick dispatch cost ~1.9 us = 0.19% of CPU).
+CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
+
+# Single-CPU; SMP-aware Weaver is a follow-up.
+CONFIG_MP_MAX_NUM_CPUS=1
+
+# Wearables stay in deepsleep most of the time.
+CONFIG_PM=y
+CONFIG_PM_DEVICE=y
