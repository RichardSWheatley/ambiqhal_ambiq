# Weaver predictive pressure-aware scheduler configuration

# Copyright (c) 2026 Ambiq Micro, Inc.
# SPDX-License-Identifier: Apache-2.0

menuconfig WEAVER_SCHED
	bool "Weaver predictive pressure-aware scheduler layer"
	depends on MULTITHREADING
	help
	  Enables the Weaver scheduling layer: a fixed-point (Q16.16),
	  pressure-aware dispatcher that classifies threads as Warp (hard
	  real-time) or Weft (opportunistic) and boosts the highest-pressure
	  Weft thread each tick. Integer-only math; no FPU dependency.
	  Designed for low-power MCUs (Apollo510 LP @ 96 MHz, nRF52840 @
	  64 MHz) handling wearable sensor pipelines.

if WEAVER_SCHED

config WEAVER_MAX_THREADS
	int "Maximum number of Weaver-managed threads"
	default 12 if WEAVER_WEARABLE_PRESET
	default 8
	range 1 64
	help
	  Bounds the per-tick scheduler evaluation cost. The dispatcher
	  iterates a fixed-size array, so latency is deterministic at
	  approximately 10-15 CPU cycles per registered thread.

config WEAVER_THROTTLE_THRESHOLD
	hex "System pressure throttle threshold (Q16.16 sum)"
	default 0x00030000 if WEAVER_WEARABLE_PRESET
	default 0x00040000
	help
	  Center of the fuzzy throttle controller's MID region (in Q16.16).
	  The TSK rules are:
	    LOW  (level=0):    pressure <= T/2
	    MID  (level=ramp): pressure in (T/2, 3T/2) - centered on T
	    HIGH (level=255):  pressure >= 3T/2
	  pressure == T yields level == 128, the binary throttle boundary.
	  Output is EMA-smoothed across 4 ticks so weaver_should_throttle()
	  does not flap when pressure dances around T. Default 0x40000 ~=
	  4.0 in Q16.16. Wearable preset uses 3.0 because FIFO overruns
	  lose irreplaceable biometric data.

config WEAVER_DEFAULT_BOOST_LEVELS
	int "Default Weft promotion magnitude (priority levels)"
	default 2 if WEAVER_WEARABLE_PRESET
	default 1
	range 1 4
	help
	  How many Zephyr priority levels a winning Weft thread climbs
	  when promoted. Wearables benefit from a stronger boost (2)
	  because sensor-fusion buffer overruns are user-visible bugs.

config WEAVER_PREWARP_GUARD_TICKS
	int "Pre-Warp guard window (ticks)"
	default 1
	range 0 16
	help
	  When the next Warp deadline is within this many ticks, the
	  dispatcher suppresses Weft promotion for the current pass to
	  give the deadline-bound thread a quiet system and warm cache.
	  This implements the "Pattern Slicing" strategy. Set to 0 to
	  disable.

config WEAVER_POWER_AWARE
	bool "Skip dispatch passes when no Weft has pressure"
	default y if WEAVER_WEARABLE_PRESET
	default n
	help
	  When set, weaver_tick() returns early if every Weft thread has
	  zero pressure. This prevents priority churn from blocking
	  deepsleep entry on battery-powered designs.

config WEAVER_USE_MVE
	bool "Use Helium MVE intrinsics for the pressure inner loop"
	depends on CPU_CORTEX_M55 || CPU_HAS_MVE
	default n
	help
	  Vectorize weaver_calculate_pressure_batch() using Helium MVE so
	  four threads' pressures are computed in parallel. Worth enabling
	  only when WEAVER_MAX_THREADS exceeds about 32, because vector
	  register save/restore on every preemption (~50 cycles) eats the
	  per-tick savings at low thread counts. Default off; integer path
	  is faster for typical wearable workloads.

config WEAVER_TIMING
	bool "Measure dispatcher cycles via DWT cycle counter"
	depends on CPU_HAS_DWT
	default n
	help
	  Enables weaver_get_last_tick_cycles() which returns the cycle
	  count of the most recent weaver_tick(). Used for on-target WCET
	  validation. Costs ~6 cycles per tick to read the counter twice.

config WEAVER_WEARABLE_PRESET
	bool "Wearable / Apollo510 LP-mode preset"
	default n
	help
	  Tunes Weaver defaults for a 96 MHz Apollo510 wearable workload:
	    - 12 thread slots (IMU, PPG, temp, BLE LL, GATT TX, fusion,
	      HR algorithm, classifier, display, NVM, logger, idle)
	    - Boost magnitude 2 (FIFO overrun is data loss)
	    - Tighter throttle (3.0 in Q16.16 vs 4.0 default)
	    - Power-aware tick skipping enabled
	  Override individual settings below if needed.

config WEAVER_SCHED_LOG_LEVEL
	int "Weaver scheduler log level"
	depends on LOG
	default 2
	range 0 4
	help
	  Log level for the Weaver scheduling layer.
	    0 = off, 1 = error, 2 = warning, 3 = info, 4 = debug.

endif # WEAVER_SCHED
